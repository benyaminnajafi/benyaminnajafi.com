---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import CaseStudy from "../components/CaseStudy.astro";
import profile from "../../content/profile.json";

const cases = (await getCollection("caseStudies")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title={`${profile.name}・${profile.jobTitle}`}>
  <Hero />

  <section id="case-studies" aria-labelledby="case-studies-title">
    <div class="section-head">
      <h2 id="case-studies-title" class="t-meta">Selected Case Studies</h2>
      <p class="t-meta">Updated: {profile.updated}</p>
    </div>

    {cases.map((entry, i) => <CaseStudy entry={entry} eager={i === 0} />)}
  </section>

  <footer class="site-footer">
    <a class="t-link" href="#top">Back to Top</a>
    <p class="ai-row t-meta">
      Get an AI summary of me:
      {
        profile.aiPromptEngines.map((engine) => (
          <a class="t-link" href={engine.url} target="_blank" rel="noopener">
            {engine.name}
          </a>
        ))
      }
    </p>
    <p class="t-meta">{profile.footer}</p>
  </footer>
</BaseLayout>

<style>
  .section-head {
    display: grid;
    grid-template-columns: 37.5% 1fr;
    gap: 16px;
    padding-block: 16px;
  }

  .site-footer {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding-block: 16px 32px;
    border-top: 1px solid var(--hairline);
  }

  .site-footer > :last-child {
    justify-self: end;
  }

  .ai-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
  }

  @media (max-width: 1199.98px) {
    .section-head {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 809.98px) {
    .site-footer {
      grid-template-columns: 1fr;
      justify-items: start;
      gap: 8px;
    }
    .site-footer > :last-child {
      justify-self: start;
    }
    .ai-row {
      justify-content: flex-start;
    }
  }
</style>
