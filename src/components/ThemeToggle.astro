---
// A sun that turns into a moon. The icons are inline SVG rather than CSS masks
// so they inherit currentColor and need no extra request.
---

<button
  class="theme-toggle"
  type="button"
  aria-label="theme switcher"
  aria-pressed="false"
>
  <!--
    Both glyphs are the original's, lifted from the mask data-URIs on
    .framer-19Ujc and .framer-7spex. The first pass drew them by hand with
    rounded stroke rays and a rounder crescent, which read as a different mark:
    these rays are solid rectangles running to the very edge of the 20x20 box,
    and the moon is a 16x16 crescent inset by 2.
  -->
  <svg class="sun" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
    <path
      fill="currentColor"
      d="M 4.995 10 C 4.995 12.761 7.241 15.007 10.002 15.007 C 12.763 15.007 15.009 12.761 15.009 10 C 15.009 7.239 12.763 4.993 10.002 4.993 C 7.241 4.993 4.995 7.239 4.995 10 Z M 9 17 L 11 17 L 11 20 L 9 20 Z M 9 0 L 11 0 L 11 3 L 9 3 Z M 0 9 L 3 9 L 3 11 L 0 11 Z M 17 9 L 20 9 L 20 11 L 17 11 Z M 3.637 17.778 L 2.223 16.364 L 4.344 14.243 L 5.758 15.657 Z M 14.242 4.344 L 16.364 2.222 L 17.778 3.636 L 15.656 5.758 Z M 4.344 5.759 L 2.223 3.637 L 3.638 2.223 L 5.758 4.345 Z M 17.778 16.364 L 16.364 17.778 L 14.242 15.656 L 15.656 14.242 Z"
    />
  </svg>
  <svg class="moon" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
    <path
      fill="currentColor"
      transform="translate(2 2)"
      d="M 8.006 16 C 3.585 16 0 12.415 0 7.994 C 0 3.725 3.34 0.237 7.549 0 C 6.197 1.101 5.334 2.779 5.334 4.658 C 5.334 7.975 8.022 10.663 11.339 10.663 C 13.22 10.663 14.899 9.798 16 8.444 C 15.766 12.656 12.277 16 8.006 16 Z"
    />
  </svg>
</button>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text);
    cursor: pointer;
    flex: none;
  }

  /* Both icons stay in the box and cross-fade. The original animates the
   * outgoing one out to scale(0.5) rotate(120deg) at opacity 0 and the
   * incoming one back to rest — measured off its live matrix, which resolves
   * to exactly that. Swapping display instead made the change snap, which is
   * the one thing about the theme switch that read as wrong. */
  .theme-toggle svg {
    grid-area: 1 / 1;
    transform-origin: 50% 50%;
    /* A small overshoot, not a linear ease. Matched to the view transition's
     * 0.35s so the icon and the page finish together rather than the rotation
     * carrying on after the colours have settled. */
    transition:
      opacity 0.35s cubic-bezier(0.34, 1.32, 0.64, 1),
      transform 0.35s cubic-bezier(0.34, 1.32, 0.64, 1);
  }

  /* Which icon shows follows the resolved theme, in CSS, so the correct one is
   * painted on the first frame rather than swapped in by script. */
  .sun {
    opacity: 1;
    transform: none;
  }
  .moon {
    opacity: 0;
    transform: scale(0.5) rotate(120deg);
  }

  :global(:root[data-theme="dark"]) .sun {
    opacity: 0;
    transform: scale(0.5) rotate(120deg);
  }
  :global(:root[data-theme="dark"]) .moon {
    opacity: 1;
    transform: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .sun {
      opacity: 0;
      transform: scale(0.5) rotate(120deg);
    }
    :global(:root:not([data-theme="light"])) .moon {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle svg {
      transition: none;
    }
  }
</style>

<script>
  // Toggling is the only part that needs JavaScript, and it is deferred: the
  // right icon and colours are already painted by the time this runs.
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>(".theme-toggle");

  const isDark = () =>
    root.dataset.theme
      ? root.dataset.theme === "dark"
      : matchMedia("(prefers-color-scheme: dark)").matches;

  const sync = () => button?.setAttribute("aria-pressed", String(isDark()));

  // The swap is immediate — no transition on the page, exactly as the original
  // does it. The motion lives in the icon, which rotates and fades on its own.
  // Anything that defers this by even a frame reads as hesitation.
  button?.addEventListener("click", () => {
    const next = isDark() ? "light" : "dark";
    root.dataset.theme = next;
    localStorage.setItem("theme", next);
    sync();
  });

  sync();
</script>
