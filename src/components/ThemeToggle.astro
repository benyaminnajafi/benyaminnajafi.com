---
// A sun that turns into a moon. The icons are inline SVG rather than CSS masks
// so they inherit currentColor and need no extra request.
---

<button
  class="theme-toggle"
  type="button"
  aria-label="Switch between light and dark"
  aria-pressed="false"
>
  <svg class="sun" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
    <circle cx="10" cy="10" r="4.2" fill="currentColor" />
    <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
      <path d="M10 1.4v2.2M10 16.4v2.2M1.4 10h2.2M16.4 10h2.2" />
      <path d="M4 4l1.6 1.6M14.4 14.4L16 16M16 4l-1.6 1.6M5.6 14.4L4 16" />
    </g>
  </svg>
  <svg class="moon" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
    <path
      d="M16.5 12.6A7 7 0 0 1 7.4 3.5a7 7 0 1 0 9.1 9.1Z"
      fill="currentColor"
    />
  </svg>
</button>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text);
    cursor: pointer;
    flex: none;
  }

  .theme-toggle svg {
    grid-area: 1 / 1;
  }

  /* Which icon shows follows the resolved theme, in CSS, so the correct one is
   * painted on the first frame rather than swapped in by script. */
  .moon {
    display: none;
  }
  :global(:root[data-theme="dark"]) .sun {
    display: none;
  }
  :global(:root[data-theme="dark"]) .moon {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .sun {
      display: none;
    }
    :global(:root:not([data-theme="light"])) .moon {
      display: block;
    }
  }
</style>

<script>
  // Toggling is the only part that needs JavaScript, and it is deferred: the
  // right icon and colours are already painted by the time this runs.
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>(".theme-toggle");

  const isDark = () =>
    root.dataset.theme
      ? root.dataset.theme === "dark"
      : matchMedia("(prefers-color-scheme: dark)").matches;

  const sync = () => button?.setAttribute("aria-pressed", String(isDark()));

  button?.addEventListener("click", () => {
    const next = isDark() ? "light" : "dark";
    root.dataset.theme = next;
    localStorage.setItem("theme", next);
    sync();
  });

  sync();
</script>
