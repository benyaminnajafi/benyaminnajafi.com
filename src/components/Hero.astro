---
import { Image } from "astro:assets";
import profile from "../../content/profile.json";
import portrait from "../assets/portrait.jpeg";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="hero">
  <div class="identity">
    <!-- Toggle and title sit on one row, so the job title is indented to the
         name's left edge rather than back under the toggle. -->
    <div class="name-row">
      <ThemeToggle />
      <div class="title-block appear" style="--appear-delay:0.3s">
        <h1 class="t-name">{profile.name}</h1>
        <p class="t-job-title">{profile.jobTitle}</p>
      </div>
    </div>
  </div>

  <div class="about">
    <Image
      src={portrait}
      alt={`${profile.name}, ${profile.jobTitle}`}
      {/*
        The portrait is 200px at desktop but only ~72px on a phone, where the
        photo drops to 21% of the width. Declaring a flat 200px made a phone
        fetch the 400w file for a 72px slot — 87% of those bytes thrown away.
      */}
      widths={[80, 160, 200, 240, 400]}
      sizes="(max-width: 809px) 22vw, (max-width: 1199px) 23vw, 200px"
      class="portrait appear appear-portrait"
      style="--appear-delay:0.9s"
      loading="eager"
      fetchpriority="high"
    />
    <div class="about-text appear" style="--appear-delay:0.6s">
      <p class="t-bio" set:html={profile.bioHtml ?? profile.bio} />
      <ul class="contacts">
        <li><a class="t-link" href={`mailto:${profile.email}`}>{profile.email}</a></li>
        <li><a class="t-link" href={`tel:${profile.phone}`}>{profile.phoneDisplay ?? profile.phone}</a></li>
        <li><a class="t-link" href={profile.linkedin} rel="me">LinkedIn</a></li>
        <li><a class="t-link" href={profile.cvUrl}>CV</a></li>
      </ul>
    </div>
  </div>
</header>

<style>
  /* Measured from the original: 24px above, 16px below, 16px between columns,
   * and the same 37.5 / 62.5 split the case study rows use. */
  .hero {
    display: grid;
    /* Framer sizes these with flex 1.2 and 2, which at 1440 gives
     * exactly 522 and 870 either side of the 16px gap. */
    grid-template-columns: 1.2fr 2fr;
    gap: 16px;
    padding-block: 24px 16px;
    /* The hero is a band, not a content-height block. Framer set
     * min-height: calc(var(--framer-viewport-height, 100vh) * .52) and pinned
     * the about column to a fixed 449px, so the band is max(52vh, 489px):
     * measured 489 at both 600px and 900px tall, 624 at 1200px. Without this
     * the whole page starts flush against the top edge. */
    min-height: 52dvh;
    align-items: start;
  }

  /* Name and job title share one width: whichever of the two is wider sets it,
   * and the other stretches to match. max-content on the column does that. */
  .identity {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: stretch;
    /* The block is only as wide as its widest line — the job title — and both
     * lines then fill it. Stretching to the grid column instead would make the
     * name a 522px box holding a 219px word. */
    width: max-content;
    max-width: 100%;
  }
  /* The block is as wide as its widest line and both lines fill it, which is
   * what the original does — name and job title share one measured width. */


  .name-row {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  /* The toggle is optically centred on the name's line, not on the two lines
   * together — measured at y=26 against a name box starting at y=15. */
  .name-row :global(.theme-toggle) {
    margin-block-start: 2px;
  }

  .title-block {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .about {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    /* Framer hard-codes height: 449px on this block at desktop. It is what
     * gives the hero its trailing whitespace: the bio and contacts total
     * 238px and the remaining 211px is deliberate empty space. */
    min-height: 449px;
  }

  .portrait {
    /* A share of the column, not a fixed width — 23% of 870 is the 200px the
     * original measures at 1440, and it keeps scaling down instead of holding
     * a phone-sized screen hostage to a 200px photo. */
    width: 23%;
    max-width: 240px;
    /* Not the file's own 959x1152 (0.832) — the original crops to a taller
     * frame, which is why the rebuild's portrait came out 240px instead of
     * 271px tall. */
    aspect-ratio: 0.738462;
    height: auto;
    object-fit: cover;
    border: 1px solid var(--hairline);
    border-radius: 4px;
    flex: none;
  }

  .about-text {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* The bio is capped rather than filling its column — measured off the
   * original, where the paragraph sits in a 560px box inside a 654px one. */
  .t-bio {
    max-width: 560px;
  }

  .contacts {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: flex-start;
  }

  /* Below the point where two columns stop fitting, the hero stacks. The
   * original shipped a separate markup variant for this; one rule does it.
   * The band ratio changes too: 60vh on tablet, 50vh on phone. */
  /* Below 1200 the bio leaves the photo's side and moves under the title, and
   * the photo takes a column of its own. `display: contents` on .about lets
   * its two children become grid items directly, so all three arrangements
   * come out of one set of markup.
   *
   * Tablet flips the split from 1.2/2 to 2/1: at 900 the original measures a
   * 568px text column beside a 284px photo column, with the photo at 68% of
   * it. */
  @media (min-width: 810px) and (max-width: 1199.98px) {
    .hero {
      grid-template-columns: 2fr 1fr;
      min-height: 60dvh;
    }
    .about {
      display: contents;
    }
    .identity {
      grid-column: 1;
      grid-row: 1;
    }
    .about-text {
      grid-column: 1;
      grid-row: 2;
      /* Same trailing whitespace the desktop band has, at the height the
       * original sets for this breakpoint. */
      min-height: 444px;
    }
    .portrait {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: start;
      /* Pinned to the right edge of its column: at 900 the original sits it at
       * x=691 in a column that starts at 600. */
      justify-self: end;
      width: 68%;
    }
  }

  /* Phone: one column, and the photo leads — at 375 the original puts it at
   * the top left and the name below it, not the other way round. */
  @media (max-width: 809.98px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 50dvh;
      padding-block: 24px 12px;
    }
    .about {
      display: contents;
    }
    .portrait {
      grid-row: 1;
      width: 21%;
    }
    .identity {
      grid-row: 2;
    }
    .about-text {
      grid-row: 3;
      min-height: 340px;
    }
  }

  /* Below 1200 the toggle sits above the title rather than beside it, so the
   * name starts at the gutter instead of 32px in. */
  @media (max-width: 1199.98px) {
    .name-row {
      flex-direction: column;
      gap: 16px;
    }
    .name-row :global(.theme-toggle) {
      margin-block-start: 0;
    }
  }
</style>
