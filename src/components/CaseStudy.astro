---
import { Image } from "astro:assets";
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"caseStudies">;
  eager?: boolean;
}
const { entry, eager = false } = Astro.props;
const { title, role, expertise, industry, caption, linkLabel, linkUrl, accent, images } =
  entry.data;
const { Content } = await render(entry);

const meta = [
  ["Role", role],
  ["Expertise", expertise],
  ["Industry", industry],
] as const;
---

<article class="case reveal">
  <div class="details">
    <h3 class="t-case-title">{title}</h3>

    <!--
      Description and credits are one block, 12px apart, with the title 32px
      above them — not three equal 32px gaps. The difference is 40px per case,
      which is what made the three longest case studies overrun the reference.
    -->
    <div class="body">
      <div class="prose t-body"><Content /></div>

      <div class="credits">
        <dl class="meta">
          {
            meta.map(([label, value]) => (
              <div class="meta-row">
                <dt class="t-meta"><span>{label}</span><span>:</span></dt>
                <dd class="t-meta">{value}</dd>
              </div>
            ))
          }
        </dl>

        <p class="link-row">
          {caption && <span class="t-meta">{caption}<span>:</span></span>}
          <a class="t-caption-link" href={linkUrl} target="_blank" rel="noopener"
            >{" "}{linkLabel}{" "}</a
          >
        </p>
      </div>
    </div>
  </div>

  <!--
    The slides are a scroll-snap strip, not a JavaScript carousel. It gives the
    same feel — drag, momentum on touch, snapping — while rendering every slide
    with scripting off, which the original did not. Pointer-drag for a mouse is
    added by a small script; without it the strip still scrolls.
  -->
  <div class="slides" style={`--accent-slide:${accent}`}>
    <div
      class="track"
      role="region"
      aria-roledescription="carousel"
      aria-label={`${title} — ${images.length} slides`}
      tabindex="0"
    >
      {
        images.map((img, i) => (
          <figure class="slide" aria-roledescription="slide" aria-label={`Slide ${i + 1} of ${images.length}`}>
            <Image
              src={img}
              alt={`${title} — slide ${i + 1}`}
              {/*
                Steps every ~256px rather than doubling. With only 512 and
                1024 to choose from, a phone at 412px and DPR 1.75 needs 721px
                and has to take the 1024 — 58% of it wasted. A 768 step covers
                that case almost exactly.

                Above 1440 the page stops growing and the slide stays 870px,
                so the vw expression is capped rather than left to climb.
              */}
              widths={[512, 768, 1024, 1280, 1600, 1920]}
              sizes="(max-width: 1199px) 100vw, (min-width: 1440px) 880px, 62vw"
              loading={eager && i === 0 ? "eager" : "lazy"}
              draggable="false"
            />
          </figure>
        ))
      }
    </div>
  </div>
</article>

<style>
  .case {
    display: grid;
    /* Framer sizes these with flex 1.2 and 2, which at 1440 gives
     * exactly 522 and 870 either side of the 16px gap. */
    grid-template-columns: 1.2fr 2fr;
    gap: 16px;
    padding-block: 16px;
    /* Below, not above: the original rules each card off at its foot, which
     * puts no line above the first card and does put one under the last. */
    border-bottom: 1px solid var(--hairline);
    align-items: start;
  }

  .details {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .credits {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  /* The original sets an 8px spacer element between the last credit row and
   * the caption link. A margin does the same job without the empty node.
   *
   * Some cases also carry an empty 24px credit slot from an unused CMS field,
   * which is why the first case study's text column measures 28px taller than
   * this one. That is residue, not design: reproducing it everywhere pushed
   * the three text-driven rows 28px past the reference. */
  .credits .link-row {
    margin-block-start: 8px;
  }

  /* Vertical rhythm, measured off the original rather than chosen.
   *
   * Framer closes every paragraph and list item with a <br><br>, so each block
   * carries one empty line of its own and the gap between blocks is zero. The
   * markdown drops those breaks — they are spacing, not content — so the same
   * line is added back as padding. Using margin instead would advance the page
   * identically but leave every block 25.6px shorter than the reference, and a
   * gap between blocks instead would put the space in the wrong place at the
   * end of a list. */
  .prose :global(p),
  .prose :global(li) {
    padding-bottom: 1.6em;
  }
  .prose :global(ul) {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .prose :global(li) {
    padding-left: 22px;
    position: relative;
  }
  .prose :global(li)::before {
    content: "•";
    position: absolute;
    left: 6px;
  }

  .meta {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .meta-row {
    display: flex;
    gap: 6px;
  }
  .meta dt,
  .meta dd {
    margin: 0;
  }
  /* Label and colon are separate blocks in the original, so the label's box is
   * the label's own width. */
  .meta dt {
    display: flex;
  }
  .meta dt > span {
    display: block;
  }
  /* The colon is its own node, as in the original, so the label measures the
   * label and the two do not merge into one wider box. */

  /* Inline, not flex: the caption and its link sit on one text line in the
   * original and a flex container would blockify the anchor, which changes both
   * its box and how the dashed underline runs across it. */
  .link-row {
    display: block;
  }

  .slides {
    position: relative;
    background: var(--accent-slide);
    border-radius: 4px;
    overflow: hidden;
    /* The original pinned this to 4:3 (870x653 at 1440). Without it the grid
     * row height comes from the text column, so the three case studies with
     * the longest copy stretched to 724 and 698 and object-fit: cover then
     * cropped the top and bottom off their screenshots. The source images are
     * all exactly 1920x1440, so at 4:3 nothing is cropped at all. */
    aspect-ratio: 4 / 3;
  }

  .track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    height: 100%;
    cursor: grab;
    /* html carries scroll-behavior: smooth for in-page links. The strip must
     * not inherit it, or a drag would lag behind the pointer. Its own
     * click-to-advance passes behavior: "smooth" explicitly. */
    scroll-behavior: auto;
    /* Dragging a strip should move it, not select the captions behind it. */
    user-select: none;
    -webkit-user-select: none;
    touch-action: pan-y;
  }
  /* :focus-visible on .track would draw its ring outside the parent's
   * overflow: hidden and be clipped away, so it is drawn inside instead. */
  .track:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .track:active {
    cursor: grabbing;
  }

  .slide {
    margin: 0;
    flex: 0 0 100%;
    scroll-snap-align: center;
    position: relative;
  }
  .slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* A 1px hairline sits inside every slide in the original, holding the
   * screenshot off its coloured backdrop. */
  .slide::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 1px solid rgba(26, 26, 26, 0.15);
    pointer-events: none;
    z-index: 2;
  }

  /* The original prints a pulsing "Click or Drag" over the bottom of every
   * slide. It is gone by request: on a pointer the custom cursor already says
   * the strip is draggable, and a label sitting on the artwork was reading as
   * a watermark. On touch the affordance is the partly-visible next slide at
   * the strip's edge.
   */

  @media (max-width: 1199.98px) {
    .case {
      grid-template-columns: 1fr;
    }
  }

  /* On tablet the original leads with the artwork and sets the description
   * beside the credits rather than above them, which keeps a stacked row from
   * running twice as long as it needs to. */
  @media (min-width: 810px) and (max-width: 1199.98px) {
    .slides {
      order: 0;
    }
    .details {
      order: 1;
    }
    .body {
      flex-direction: row;
      gap: 16px;
    }
    .prose {
      flex: 2 0 0;
    }
    .credits {
      flex: 1 0 0;
    }
  }
</style>

<script>
  // Click and drag, which is what the hint promises.
  //
  // The original advances one slide on click and treats a gesture as a swipe
  // only past a small threshold. Without the click half, the only way to reach
  // slides two and up was to guess that the strip could be dragged.
  const SWIPE = 5; // px of travel before a gesture stops counting as a click

  for (const track of document.querySelectorAll<HTMLElement>(".track")) {
    let startX = 0;
    let startLeft = 0;
    let moved = 0;
    let dragging = false;

    const advance = () => {
      const step = track.clientWidth;
      if (!step) return;
      const last = track.children.length - 1;
      const next = Math.round(track.scrollLeft / step) + 1;
      track.scrollTo({ left: (next > last ? 0 : next) * step, behavior: "smooth" });
    };

    track.addEventListener("pointerdown", (e) => {
      startX = e.clientX;
      startLeft = track.scrollLeft;
      moved = 0;
      // Only a mouse is scrolled by hand; touch already does this natively and
      // taking it over is what made the first build feel laggy on a phone.
      dragging = e.pointerType === "mouse";
      if (dragging) track.setPointerCapture(e.pointerId);
    });

    track.addEventListener("pointermove", (e) => {
      const dx = e.clientX - startX;
      moved = Math.max(moved, Math.abs(dx));
      if (!dragging) return;
      e.preventDefault();
      track.scrollLeft = startLeft - dx;
    });

    track.addEventListener("pointerup", () => {
      if (moved < SWIPE) advance();
      dragging = false;
    });
    track.addEventListener("pointercancel", () => {
      dragging = false;
    });

    // Arrow keys, since the strip is focusable.
    track.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
      e.preventDefault();
      const step = track.clientWidth;
      const delta = e.key === "ArrowRight" ? step : -step;
      track.scrollTo({ left: track.scrollLeft + delta, behavior: "smooth" });
    });
  }

  // Each case study lifts into place as it comes into view, rather than being
  // fully drawn the instant it is scrolled past.
  //
  // The hidden state is applied only once this runs, so a reader without
  // JavaScript gets the whole page rather than seven invisible sections. The
  // observer releases each item and stops watching it — a reveal that replays
  // every time you scroll back up is a distraction, not a flourish.
  const revealable = document.querySelectorAll<HTMLElement>(".reveal");
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (revealable.length && "IntersectionObserver" in window && !still) {
    document.documentElement.setAttribute("data-reveal-ready", "");

    const io = new IntersectionObserver(
      (entries, observer) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      },
      // Start it a little before the top edge, so the movement has finished by
      // the time the item is properly in view.
      { rootMargin: "0px 0px -12% 0px", threshold: 0.05 },
    );

    for (const el of revealable) io.observe(el);
  }
</script>
