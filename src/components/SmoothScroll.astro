---
// Smooth scrolling, matching the original exactly.
//
// The old site ran @studio-freight/lenis through a Framer code component
// (sources/LenisScroll.tsx). That package is deprecated in favour of `lenis`,
// which is the same library under its current name. Every option below is
// copied from that component rather than chosen: duration is `intensity / 10`
// with intensity defaulting to 12, and the easing curve is verbatim.
//
// This is the one behaviour that most defines how the site feels, and leaving
// it out was the reason the first rebuild felt wrong even where it measured
// right.
---

<script>
  import Lenis from "lenis";

  // A reader who has asked their system to reduce motion means it. The original
  // had no such check; adding one changes nothing for everyone else.
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!reduced) {
    if ("scrollRestoration" in history) {
      history.scrollRestoration = "manual";
    }

    const lenis = new Lenis({
      duration: 1.2,
      easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      smoothWheel: true,
      touchMultiplier: 1,
      infinite: false,
    });

    lenis.scrollTo(0, { immediate: true });

    const raf = (time: number) => {
      lenis.raf(time);
      requestAnimationFrame(raf);
    };
    requestAnimationFrame(raf);

    // In-page anchors have to go through Lenis; letting the browser jump would
    // fight the animation loop and land in the wrong place.
    for (const link of document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')) {
      link.addEventListener("click", (event) => {
        const id = link.getAttribute("href")!;
        const target = id === "#top" ? 0 : document.querySelector<HTMLElement>(id);
        if (target === null) return;
        event.preventDefault();
        lenis.scrollTo(target as 0 | HTMLElement);
      });
    }

    // The carousels scroll horizontally. Lenis owns the wheel, so a wheel event
    // over a track has to be handed back or the strip cannot be scrolled.
    for (const track of document.querySelectorAll<HTMLElement>(".track")) {
      track.addEventListener("mouseenter", () => lenis.stop());
      track.addEventListener("mouseleave", () => lenis.start());
    }
  }
</script>
