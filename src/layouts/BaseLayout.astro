---
import "../styles/tokens.css";
import "../styles/type.css";
import "../styles/base.css";
import profile from "../../content/profile.json";
import Cursor from "../components/Cursor.astro";
// The bio paragraph is the LCP element, and it is set in Manrope 600 — so the
// font is on the critical path, not competing with it. Lighthouse put the
// fonts at the end of the longest request chain (3.0s) because nothing
// discovers them until the inlined CSS has been parsed and matched.
//
// One file now covers every weight on the page, so one preload does what four
// used to. The four static cuts were dropped: the variable face spans 200-800
// on its own and renders identically at each weight.
import manropeVariable from "../assets/fonts/manrope-variable.woff2";

const preloadFonts = [manropeVariable];

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}
const { title, description = profile.bio, canonical } = Astro.props;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og-image.webp", Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- The original shipped both icons and a full social card; the first
         rebuild shipped neither, so every link shared to LinkedIn or Slack
         unfurled as a bare URL. -->
    {
      preloadFonts.map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
      ))
    }

    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!--
      Theme, before first paint.

      This has to be inline and in the head, not a module: anything deferred
      runs after the first paint, and the page would flash light before turning
      dark. It is the one script that must block, and it is four lines.

      The old site did this by walking document.styleSheets at runtime, reading
      the token declarations back out of the CSSOM and injecting a new <style>.
      Declaring the tokens twice in CSS makes all of that unnecessary.
    -->
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("theme");
        if (saved === "light" || saved === "dark") {
          document.documentElement.dataset.theme = saved;
        }
      })();
    </script>
  </head>
  <body>
    <main class="page">
      <slot />
    </main>
    <Cursor />
  </body>
</html>

<style>
  /* The page is a single column capped at 1440, with a 16px gutter. Everything
   * inside it shares one grid ratio, measured off the original: the text column
   * and the wide column split 522 / 870 at 1440px, which is 37.5% / 62.5%
   * either side of a 16px gap. */
  .page {
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: 16px;
  }
</style>
