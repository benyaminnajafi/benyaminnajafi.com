{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "order": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "expertise": {
      "type": "string",
      "minLength": 1
    },
    "industry": {
      "type": "string",
      "minLength": 1
    },
    "caption": {
      "default": "",
      "type": "string"
    },
    "linkLabel": {
      "type": "string",
      "minLength": 1
    },
    "linkUrl": {
      "type": "string",
      "format": "uri"
    },
    "accent": {
      "type": "string",
      "pattern": "^#[0-9a-f]{6}$"
    },
    "images": {
      "minItems": 1,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "framerId": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "order",
    "title",
    "role",
    "expertise",
    "industry",
    "linkLabel",
    "linkUrl",
    "accent",
    "images"
  ]
}