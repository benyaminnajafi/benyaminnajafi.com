# ابزار gstack
.gstack/

# لاگ و فایل‌های موقت کراول.
# manifest.json و original/ عمداً کامیت می‌شوند — `mirror.py --rewrite`
# بازنویسی را همیشه از روی original/ انجام می‌دهد و بدونش کار نمی‌کند.
.mirror/*.log
.mirror/*.out
.mirror/*.bin

# پایتون
__pycache__/
*.py[cod]

# macOS
.DS_Store

# build output of the rewrite
dist/
node_modules/

# `astro preview` writes these each run, and drops a copy wherever it is run
# from — hence the leading **. The generated types beside them are committed
# on purpose.
**/.astro/preview.json
**/.astro/preview.log
